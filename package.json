{
  "name": "bluebox",
  "author": "Blue Devil Robotics",
  "description": "BlueBox is a dashboard application for debugging VEX V5 robots.",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev -w --sourcemap",
    "build": "tsc --noEmit --composite false && electron-vite build",
    "build:win": "yarn run build && electron-builder --win",
    "build:mac": "yarn run build && electron-builder --mac",
    "build:linux": "yarn run build && electron-builder --linux",
    "build:test": "yarn run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.5",
    "@mui/material": "^6.1.5",
    "@vitejs/plugin-react": "^4.3.3",
    "chalk": "^4",
    "express": "^4.21.1",
    "interweave": "^13.1.0",
    "jotai": "^2.10.1",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "recharts": "^2.13.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin-ts": "^2.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/serialport": "^8.0.5",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.11.0",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
