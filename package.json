{
  "name": "vexbridge",
  "author": "devilbots",
  "description": "Communication layer between the VEX V5 brain and a Raspberry Pi.",
  "repository": "https://github.com/UWST-Robotics/BlueBox/",
  "private": true,
  "type": "module",
  "version": "0.1.2",
  "license": "GPL-3.0",
  "scripts": {
    "dev:client": "vite dev",
    "dev:server": "tsx watch src/main/main.ts",
    "dev": "concurrently -r \"yarn dev:server\" \"yarn dev:client\"",
    "build:client": "vite build",
    "build:server": "./esbuild.cjs",
    "build": "npm run build:client && npm run build:server",
    "package": "debian dist/server.js --output dist/vexbridge --target node16-linux-x64 --config package.json",
    "serve": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.5",
    "@mui/material": "^6.1.5",
    "@vitejs/plugin-react": "^4.3.3",
    "ansi-to-react": "^6.1.6",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "jotai": "^2.10.1",
    "konva": "^9.3.16",
    "mathjs": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "recharts": "^2.13.2",
    "rpio": "^2.4.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin-ts": "^2.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/rpio": "^2.4.6",
    "@types/serialport": "^8.0.5",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
